{
  "name": "keepsake",
  "version": "0.1.0",
  "description": "Your X saves, available to your agents: a local library, CLI and MCP server.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/cli.ts serve",
    "test": "node --test test/*.test.ts",
    "demo": "node src/cli.ts demo",
    "search": "node src/cli.ts search",
    "mcp": "node src/cli.ts mcp",
    "format:check": "prettier --check src extension test scripts examples docs app components lib next.config.ts postcss.config.json tsconfig*.json components.json package.json config.example.json README.md AGENTS.md",
    "dev": "KEEPSAKE_DEV=1 node src/cli.ts serve",
    "build": "npm run build:extension && next build --webpack",
    "build:extension": "node scripts/build-extension.ts",
    "pretest": "npm run build:extension",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.extension.json --noEmit && tsc --project tsconfig.test.json --noEmit"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.4",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.0",
    "prettier": "^3.9.8",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@tailwindcss/postcss": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.47.0",
    "next": "^16.3.8",
    "postcss": "^8.5.28",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "swr": "^2.5.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  }
}
